# Copy to .env (never commit .env). All values below are safe placeholders.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# --- Database (docker-compose overrides DATABASE_URL for containers) ---
DATABASE_URL=postgresql+psycopg://memohub:memohub@localhost:5432/memohub
POSTGRES_PASSWORD=memohub

# --- Authentication ---
# dev  = pick a seeded user without a password (refused when ENVIRONMENT=production)
# oidc = OpenID Connect (Microsoft Entra ID recommended)
AUTH_MODE=dev
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false      # MUST be true behind HTTPS / in production
OIDC_ISSUER=                     # e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=               # e.g. https://memohub.example.com/api/v1/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=/

# --- Secret storage for user API keys (AES-256-GCM keyring) ---
# Generate with: cd backend && python -m app.cli generate-key
# Format: kid:base64key[,oldkid:base64key]   (first key encrypts, all decrypt)
# Leave empty to refuse API keys entirely (only the mock provider will work).
SECRET_ENCRYPTION_KEYS=
ALLOW_PERSISTENT_API_KEYS=true

# --- AI providers ---
ENABLE_MOCK_PROVIDER=true        # must be false in production
AI_REQUEST_TIMEOUT_SECONDS=60
AI_OUTPUT_MAX_ATTEMPTS=3
AI_RATE_LIMIT_PER_MINUTE=20
ALLOW_PRIVATE_PROVIDER_URLS=false
PROVIDER_BASE_URL_ALLOWLIST=     # comma-separated hostnames for openai_compatible

# --- Processing limits ---
MAX_UPLOAD_BYTES=2097152
MAX_TRANSCRIPT_ENTRIES=5000
TRANSLATION_CHUNK_MAX_ENTRIES=20
TRANSLATION_CHUNK_MAX_CHARS=6000
MEMO_MAX_TRANSCRIPT_CHARS=120000

# --- Jobs ---
EMBEDDED_WORKER=false            # true = run the worker inside the API process (single-process dev)
JOB_MAX_ATTEMPTS=2

# --- Web ---
CORS_ALLOWED_ORIGINS=            # not needed when using the Next.js proxy
TRUSTED_HOSTS=*                  # set explicit hostnames in production
SEED_DEMO_DATA=true

# --- Meeting platform integrations (Workstream 2) — see docs/integrations/*.md ---
# Platform OAuth tokens are encrypted with SECRET_ENCRYPTION_KEYS and stored separately from AI API keys.
PUBLIC_BASE_URL=http://localhost:3000          # https in production; OAuth redirect = {this}/api/v1/integrations/{provider}/oauth/callback
INTEGRATION_OAUTH_STATE_TTL_MINUTES=10
INTEGRATION_WEBHOOK_MAX_BYTES=65536
INTEGRATION_WEBHOOK_TOLERANCE_SECONDS=300
INTEGRATION_FETCH_MAX_ATTEMPTS=8
INTEGRATION_FETCH_BASE_DELAY_SECONDS=60
INTEGRATION_FETCH_MAX_DELAY_SECONDS=3600
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=                           # secret manager
TEAMS_TENANT_ID=organizations
TEAMS_REQUEST_TRANSCRIPT_SCOPE=true            # false = connect without admin consent (transcripts via import only)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=                            # secret manager
ZOOM_WEBHOOK_SECRET_TOKEN=                     # secret manager
ZOOM_SCOPES=                                   # space-separated, exactly as configured on the Zoom app
ZOOM_RTMS_ENABLED=false                        # requires RTMS provisioning + pip install '.[zoom-rtms]'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                          # secret manager
# DEV/TEST ONLY: JSON {"teams": "...", "zoom": "...", "google_meet": "..."} pointing at the fake provider
# server (python -m tests.fakes.server). Marks every connection SANDBOX; refused in production.
INTEGRATION_ENDPOINT_OVERRIDES=

# --- Frontend (server-side only; never NEXT_PUBLIC_) ---
BACKEND_URL=http://localhost:8000
